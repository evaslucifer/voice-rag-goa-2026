# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
DATA_MODE=demo
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]
FRONTEND_ORIGIN=

# External API Keys (Leave blank for local fallback during testing)
SARVAM_API_KEY=your_sarvam_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant Vector Database Configuration
# Set QDRANT_URL to "http://localhost:6333" if using Docker, or leave blank to use embedded local storage at QDRANT_PATH
QDRANT_URL=
QDRANT_PATH=./qdrant_storage
QDRANT_API_KEY=
QDRANT_COLLECTION=msmarco_demo
QDRANT_TIMEOUT_SECONDS=5.0

# Embedding Service (FastEmbed ONNX)
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32

# Retrieval & Guardrail Parameters
RETRIEVAL_TOP_K=3
RETRIEVAL_SCORE_THRESHOLD=0.65
GUARDRAILS_ENABLED=true

# Chunking Configuration (semantic, parent_child, metadata, or fixed)
CHUNKING_STRATEGY=semantic
CHUNK_SIZE=200
CHUNK_OVERLAP=40
PARENT_CHUNK_SIZE=512
CHILD_CHUNK_SIZE=128

# LLM Inference Configuration (groq, gemini, or local)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.1-8b-instant
LLM_FALLBACK_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=6.0

# Sarvam STT Streaming Configuration
SARVAM_STT_LANGUAGE_CODE=en-IN
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_TIMEOUT_SECONDS=10.0
